---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sections, url } from '../../site';
import { getEntries, formatDate } from '../../lib/entries';

// One page per entry, for every room.
export async function getStaticPaths() {
  const paths = [];
  for (const section of sections) {
    const entries = await getEntries(section.slug); // newest first
    entries.forEach((entry, i) => {
      paths.push({
        params: { section: section.slug, slug: entry.slug },
        props: {
          entry,
          section,
          newer: entries[i - 1],
          older: entries[i + 1],
        },
      });
    });
  }
  return paths;
}

const { entry, section, newer, older } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.note}>
  <article class="page" style={`--door:${section.door}`}>
    <header class="entry-head">
      <a class="crumb" href={url(`/${section.slug}/`)}>← {section.name}</a>
      <h1>{entry.data.title}</h1>
      <span class="entry-date">{formatDate(entry.data.date)}</span>
      {entry.data.note && <span class="entry-note">{entry.data.note}</span>}
      {entry.data.shelf && <span class="shelf-tag">{entry.data.shelf}</span>}
      {
        entry.data.link && (
          <a class="source" href={entry.data.link} target="_blank" rel="noopener noreferrer">
            Open the original ↗
          </a>
        )
      }
      {section.stamp && <span class="stamp" aria-hidden="true">{section.stamp}</span>}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="More in this room">
    {older && <a href={url(`/${section.slug}/${older.slug}/`)}>← {older.data.title}</a>}
    {newer && <a class="next" href={url(`/${section.slug}/${newer.slug}/`)}>{newer.data.title} →</a>}
  </nav>
</Base>

<script>
  // Ruled paper needs every block to be a whole number of lines tall. A picture is
  // never exactly that, so pad the space under each one up to the next ruled line.
  function snapImagesToLines() {
    const line = parseFloat(getComputedStyle(document.documentElement).fontSize) * 2; // 2rem
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      const holder = img.parentElement;
      if (!holder) return;
      holder.style.paddingBottom = '0px';
      const over = holder.getBoundingClientRect().height % line;
      holder.style.paddingBottom = over < 0.5 ? '0px' : `${line - over}px`;
    });
  }
  window.addEventListener('load', snapImagesToLines);
  window.addEventListener('resize', snapImagesToLines);
</script>
