---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { sections } from '../../site';
import { getEntries } from '../../lib/entries';

// Astro builds one page per room listed in src/site.ts.
export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
const entries = await getEntries(section.slug);

// Rooms with shelves show one heading per shelf. Anything on an unknown shelf
// (or none) goes under "More", so nothing ever disappears from the page.
let groups: { name: string; entries: typeof entries }[] | null = null;
if (section.shelves) {
  const known = new Set(section.shelves);
  groups = section.shelves.map((name) => ({
    name,
    entries: entries.filter((e) => e.data.shelf === name),
  }));
  const rest = entries.filter((e) => !e.data.shelf || !known.has(e.data.shelf));
  if (rest.length) groups.push({ name: 'More', entries: rest });
}
---

<Base title={section.name} description={section.blurb}>
  <h1 class="page-title">{section.name}</h1>
  <p class="page-blurb">{section.blurb}</p>

  {
    groups ? (
      groups.map((g) => (
        <section class="shelf">
          <h2 class="section-label">{g.name}</h2>
          <EntryList entries={g.entries} emptyText="Nothing on this shelf yet." />
        </section>
      ))
    ) : (
      <EntryList entries={entries} />
    )
  }
</Base>
