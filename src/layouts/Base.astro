---
import '../styles/global.css';
import { site, sections, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{site.title}</a>
        <nav class="nav" aria-label="Rooms">
          {
            sections.map((s) => (
              <a
                href={url(`/${s.slug}/`)}
                aria-current={here.includes(`/${s.slug}/`) ? 'page' : undefined}
              >
                {s.name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">written by hand, kept with care</div>
    </footer>
  </body>
</html>
