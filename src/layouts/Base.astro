---
// Fonts are bundled with the site (not fetched from Google), so the handwriting
// always shows up, loads faster, and nothing is sent to a third party.
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/600.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import { site, sections, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the lamp's saved choice before the page paints, so there's no flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{site.title}</a>
        <nav class="nav" aria-label="Rooms">
          {
            sections.map((s) => (
              <a
                href={url(`/${s.slug}/`)}
                aria-current={here.includes(`/${s.slug}/`) ? 'page' : undefined}
              >
                {s.name}
              </a>
            ))
          }
        </nav>
        <button class="lamp" type="button" aria-pressed="false" aria-label="Lamp switch: turn the evening on or off" title="Lamp switch">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle class="glow" cx="16" cy="15" r="11" fill="#f2c777" opacity="0.18" />
            <path d="M9 16 12 5h8l3 11z" fill="currentColor" />
            <path d="M16 16v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <ellipse cx="16" cy="27" rx="6" ry="1.8" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="porch" aria-hidden="true"></span>
        the porch light is always on
      </div>
    </footer>
  </body>
</html>

<script>
  // The lamp switch. With no choice made, the site follows the phone (day or evening).
  // Tapping the lamp flips it, and the choice is remembered on this phone.
  const root = document.documentElement;
  const lamp = document.querySelector<HTMLButtonElement>('.lamp');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : media.matches);
  const sync = () => lamp?.setAttribute('aria-pressed', String(isDark()));

  sync();
  media.addEventListener('change', sync);
  lamp?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      // storage can be blocked (private tabs); the lamp still works for this visit
    }
    sync();
  });
</script>
