---
// Fonts are bundled with the site (not fetched from Google), so the handwriting
// always shows up, loads faster, and nothing is sent to a third party.
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/600.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import { site, sections, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{site.title}</a>
        <nav class="nav" aria-label="Rooms">
          {
            sections.map((s) => (
              <a
                href={url(`/${s.slug}/`)}
                aria-current={here.includes(`/${s.slug}/`) ? 'page' : undefined}
              >
                {s.name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="porch" aria-hidden="true"></span>
        the porch light is always on
      </div>
    </footer>
  </body>
</html>
